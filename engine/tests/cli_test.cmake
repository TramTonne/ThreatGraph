execute_process(COMMAND "${ENGINE}" "${EXAMPLE}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Example failed: ${output}")
endif()
string(JSON target GET "${output}" baseline sources 0 shortest_paths 0 target)
if(NOT target STREQUAL "customer-db")
  message(FATAL_ERROR "Unexpected target: ${output}")
endif()
execute_process(COMMAND "${ENGINE}" - INPUT_FILE "${EXAMPLE}" RESULT_VARIABLE status OUTPUT_VARIABLE stdin_output)
if(NOT status EQUAL 0 OR NOT stdin_output STREQUAL output)
  message(FATAL_ERROR "stdin/file results differ")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/invalid-request.json" "{broken")
execute_process(COMMAND "${ENGINE}" "${CMAKE_CURRENT_BINARY_DIR}/invalid-request.json" RESULT_VARIABLE status OUTPUT_VARIABLE output)
string(JSON code GET "${output}" error code)
if(NOT status EQUAL 1 OR NOT code STREQUAL "invalid_input")
  message(FATAL_ERROR "Invalid JSON did not produce structured error")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/invalid-request.json" "{} {}")
execute_process(COMMAND "${ENGINE}" "${CMAKE_CURRENT_BINARY_DIR}/invalid-request.json" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "Trailing JSON accepted")
endif()
